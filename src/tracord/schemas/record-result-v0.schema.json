{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracord.dev/schemas/record-result-v0.schema.json",
  "title": "Tracord Record Result v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_version", "command", "ok", "exit_code", "error", "run"],
  "properties": {
    "result_version": {"const": "tracord.record-result.v0"},
    "command": {"const": "record"},
    "ok": {"type": "boolean"},
    "exit_code": {"type": "integer", "minimum": 0, "maximum": 2},
    "error": {
      "type": ["string", "null"],
      "enum": [null, "record_command_required", "record_store_unwritable", "record_spawn_failed", "record_failed", "record_result_invalid"]
    },
    "run": {"oneOf": [{"$ref": "#/$defs/fullRun"}, {"type": "null"}]}
  },
  "oneOf": [
    {
      "properties": {"error": {"type": "null"}, "run": {"$ref": "#/$defs/fullRun"}}
    },
    {
      "properties": {"error": {"type": "string"}, "run": {"type": "null"}, "ok": {"const": false}},
      "required": ["error"]
    }
  ],
  "allOf": [
    {
      "if": {"properties": {"ok": {"const": true}}, "required": ["ok"]},
      "then": {"properties": {"exit_code": {"const": 0}, "error": {"type": "null"}, "run": {"$ref": "#/$defs/passedRun"}}},
      "else": {"properties": {"exit_code": {"minimum": 1}}}
    }
  ],
  "$defs": {
    "runId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"},
    "decodeReplacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": {"enum": ["none", "present", "unknown"]},
        "stderr": {"enum": ["none", "present", "unknown"]}
      }
    },
    "fullRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "status", "process_exit_code", "timed_out", "duration_ms", "redacted", "decode_replacement", "store_identity_verified"],
      "properties": {
        "run_id": {"$ref": "#/$defs/runId"},
        "status": {"enum": ["passed", "failed", "timeout"]},
        "process_exit_code": {"type": ["integer", "null"], "minimum": -2147483648, "maximum": 4294967295},
        "timed_out": {"type": "boolean"},
        "duration_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "redacted": {"type": "boolean"},
        "decode_replacement": {"$ref": "#/$defs/decodeReplacement"},
        "store_identity_verified": {"type": "boolean"}
      }
    },
    "passedRun": {
      "allOf": [
        {"$ref": "#/$defs/fullRun"},
        {"properties": {"status": {"const": "passed"}}}
      ]
    }
  }
}
