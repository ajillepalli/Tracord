{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracord.dev/schemas/trace-v0.schema.json",
  "title": "Tracord Trace v0",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "toolInputCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture"],
      "properties": {
        "capture": {
          "enum": ["captured", "redacted", "omitted"]
        },
        "value": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capture": {
                "enum": ["captured", "redacted"]
              }
            },
            "required": ["capture"]
          },
          "then": {
            "required": ["value"]
          },
          "else": {
            "not": {
              "required": ["value"]
            }
          }
        }
      ]
    },
    "toolOutputCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture"],
      "properties": {
        "capture": {
          "enum": ["captured", "redacted", "omitted"]
        },
        "value": true
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capture": {
                "enum": ["captured", "redacted"]
              }
            },
            "required": ["capture"]
          },
          "then": {
            "required": ["value"]
          },
          "else": {
            "not": {
              "required": ["value"]
            }
          }
        }
      ]
    },
    "toolCallStartedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "name", "input"],
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "#/$defs/toolInputCapture"
        }
      }
    },
    "toolCallFinishedData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "outcome", "duration_ms", "output"],
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": ["succeeded", "failed", "cancelled", "timeout"]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output": {
          "$ref": "#/$defs/toolOutputCapture"
        },
        "error_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z]",
          "not": {
            "pattern": "[^A-Za-z0-9_.-]"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "failed"
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "required": ["error_type"]
          },
          "else": {
            "not": {
              "required": ["error_type"]
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "kind",
    "status",
    "command",
    "cwd",
    "started_at",
    "finished_at",
    "duration_ms",
    "exit_code",
    "timed_out",
    "redacted",
    "artifacts",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "tracord.trace.v0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "command"
    },
    "name": {
      "type": ["string", "null"]
    },
    "status": {
      "enum": ["passed", "failed", "timeout"]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "pid": {
      "type": "integer"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "timeout_seconds": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "exit_code": {
      "type": ["integer", "null"]
    },
    "timed_out": {
      "type": "boolean"
    },
    "redacted": {
      "type": "boolean"
    },
    "output_encoding": {
      "type": "string",
      "minLength": 1
    },
    "decode_replacement": {
      "type": "object",
      "required": ["stdout", "stderr"],
      "additionalProperties": false,
      "properties": {
        "stdout": {
          "enum": ["none", "present", "unknown"]
        },
        "stderr": {
          "enum": ["none", "present", "unknown"]
        }
      }
    },
    "store_identity_verified": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "object",
      "required": ["stdout", "stderr"],
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        }
      }
    },
    "file_changes": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": true,
      "properties": {
        "status": {
          "enum": ["captured", "unchanged", "skipped", "omitted", "error"]
        },
        "reason": {
          "type": "string"
        },
        "changed_files": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status", "path"],
            "additionalProperties": true,
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "old_path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "artifact": {
          "const": "changes.patch"
        },
        "max_diff_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "git_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "redacted": {
          "type": "boolean"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "at", "data"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "tool.call.started"
                }
              },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "data": {
                  "$ref": "#/$defs/toolCallStartedData"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "tool.call.finished"
                }
              },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "data": {
                  "$ref": "#/$defs/toolCallFinishedData"
                }
              }
            }
          }
        ]
      }
    }
  }
}
