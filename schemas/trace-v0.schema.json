{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracord.dev/schemas/trace-v0.schema.json",
  "title": "Tracord Trace v0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "kind",
    "status",
    "command",
    "cwd",
    "started_at",
    "finished_at",
    "duration_ms",
    "exit_code",
    "timed_out",
    "redacted",
    "artifacts",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "tracord.trace.v0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "command"
    },
    "name": {
      "type": ["string", "null"]
    },
    "status": {
      "enum": ["passed", "failed", "timeout"]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "pid": {
      "type": "integer"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "timeout_seconds": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "exit_code": {
      "type": ["integer", "null"]
    },
    "timed_out": {
      "type": "boolean"
    },
    "redacted": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "object",
      "required": ["stdout", "stderr"],
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "at", "data"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
  }
}
